[package]
-> name        => hdm
-> version     => 0.7.0
-> description => HDM — HackerOS Display Manager (H# + Silver + Solid.js)
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => GPL-3.0

[workspace]
-> members => [common, daemon, greeter]

[commands]
-> build-all
--> run => bit build
--> description => Zbuduj wszystko (common -> daemon + greeter)
-> test
--> run => sh common/native/tests/run.sh && cd daemon && bit test && cd ../greeter && bit test
--> description => Testy: warstwa natywna (C), daemon (H#), greeter (H# + vitest)
-> lint
--> run => python3 tools/lint_hsharp.py common daemon greeter && cd greeter/frontend && npm run lint
--> description => Linter składni H# (bez kompilatora) + ESLint frontendu
-> default-config
--> run => python3 tools/gen_default_config.py
--> description => Wygeneruj daemon/src/default_config.h# z config/hdm.hk
-> fonts
--> run => cd greeter/frontend && python3 ../../tools/merge_fonts.py
--> description => Scal czcionki latin + latin-ext do greeter/frontend/fonts/*.ttf
