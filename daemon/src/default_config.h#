pub fn text() -> string is
    let mut out: string = ""
    out = out + "! /etc/hdm/hdm.hk - HDM (HackerOS Display Manager) Configuration\n"
    out = out + "!\n"
    out = out + "! Format: .hk - HackerOS's own configuration format (a TOML alternative\n"
    out = out + "! with explicit \"-> key => value\" nesting and built-in ${{...}}\n"
    out = out + "! interpolation). Full syntax reference:\n"
    out = out + "!   https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html\n"
    out = out + "!\n"
    out = out + "! This file is installed verbatim by `build.hl install` / the .deb / the\n"
    out = out + "! .rpm the first time HDM is set up (an existing /etc/hdm/hdm.hk is never\n"
    out = out + "! overwritten - see install_config in build.hl). It is also what the\n"
    out = out + "! daemon itself writes to a fresh /etc/hdm/hdm.hk if none exists yet, via\n"
    out = out + "! config::ensure_default_config() in daemon/src/config.h#.\n"
    out = out + "!\n"
    out = out + "! IMPORTANT for maintainers: daemon/src/tests.h# has a test\n"
    out = out + "! (test_packaged_config_matches_default_config) that asserts this\n"
    out = out + "! file parses to exactly the same HdmConfig as\n"
    out = out + "! config::default_config_content() (daemon/src/default_config.h#) - [general], [autologin], [default] and\n"
    out = out + "! [power] alike. If you change a value in one, change it in the other -\n"
    out = out + "! `cd daemon && bit test` will fail loudly if they drift apart.\n"
    out = out + "\n"
    out = out + "[general]\n"
    out = out + "! Path to the greeter binary the daemon spawns on VT switch.\n"
    out = out + "-> greeter_path   => \"/usr/bin/hdm-greeter\"\n"
    out = out + "\n"
    out = out + "! Virtual terminal HDM switches to before launching the greeter.\n"
    out = out + "-> vt             => 1\n"
    out = out + "\n"
    out = out + "! Memory limit (MiB, compositor + greeter combined) for the login screen. The daemon\n"
    out = out + "! restarts the greeter when it grows past this (a long-idle login screen could\n"
    out = out + "! otherwise exhaust RAM). 0 disables the check.\n"
    out = out + "-> greeter_memory_limit => 1024\n"
    out = out + "\n"
    out = out + "! Greeter theme name (passed through to the UI, see ui/src/app.css).\n"
    out = out + "-> theme          => graphite\n"
    out = out + "\n"
    out = out + "! Path to the wallpaper image shown behind the login screen. Falls back\n"
    out = out + "! to a handful of hardcoded paths (see get_wallpaper() in\n"
    out = out + "! greeter/src/main.h#) if this is unset, empty, or the file is missing.\n"
    out = out + "-> background     => \"/usr/share/wallpapers/HackerOS-Wallpapers/Wallpaper23.png\"\n"
    out = out + "\n"
    out = out + "! Show the list of local users (UID between minimum_uid and maximum_uid)\n"
    out = out + "! on the login screen, rather than only a plain username field.\n"
    out = out + "-> show_user_list => true\n"
    out = out + "\n"
    out = out + "! Whether \"root\" is an allowed login username. Kept off by default -\n"
    out = out + "! logging in graphically as root is almost never what you want.\n"
    out = out + "-> allow_root     => false\n"
    out = out + "\n"
    out = out + "! Whether the greeter's \"Guest\" button is shown at all. See\n"
    out = out + "! daemon/src/users.h#::ensure_guest_account for what a guest session is.\n"
    out = out + "-> allow_guest    => false\n"
    out = out + "\n"
    out = out + "! Only users with minimum_uid <= UID <= maximum_uid show up in the login\n"
    out = out + "! screen's user list. Live-mode autologin (see [autologin] -> live_detect\n"
    out = out + "! below) is NOT limited by this range on purpose - see\n"
    out = out + "! daemon/src/users.h#::find_live_user.\n"
    out = out + "-> minimum_uid    => 1000\n"
    out = out + "-> maximum_uid    => 65533\n"
    out = out + "\n"
    out = out + "! strftime-style format string for the greeter's on-screen clock.\n"
    out = out + "-> clock_format   => \"%H:%M\"\n"
    out = out + "\n"
    out = out + "! Directories scanned for Wayland/X11 session .desktop files (see\n"
    out = out + "! daemon/src/session.h#::list_sessions). Later entries are for\n"
    out = out + "! locally-installed sessions that override the system-wide ones.\n"
    out = out + "-> sessions_dir   => [\"/usr/share/wayland-sessions\", \"/usr/share/xsessions\", \"/usr/local/share/wayland-sessions\"]\n"
    out = out + "\n"
    out = out + "! Wayland compositor HDM wraps the greeter binary in before launching it\n"
    out = out + "! (see spawn_greeter_command() / apply_compositor_args() in\n"
    out = out + "! daemon/src/main.h#). The greeter is a\n"
    out = out + "! windowed Silver (SDL2) app, not a compositor itself, so it needs one to\n"
    out = out + "! actually get a display to render into pre-login. \"cage\" (a single-app\n"
    out = out + "! Wayland kiosk compositor, see https://github.com/cage-kiosk/cage) is\n"
    out = out + "! used by default; set to \"none\" to launch greeter_path directly instead.\n"
    out = out + "! \"labwc\" (a full wlroots-based stacking window manager, see\n"
    out = out + "! https://github.com/labwc/labwc, run here single-app-style via its own\n"
    out = out + "! -S/--session flag) is also recognized by name and worth trying if cage\n"
    out = out + "! itself is the problem on a given machine - cage and labwc are separate\n"
    out = out + "! wlroots-based compositors with their own renderer code, so a crash\n"
    out = out + "! specific to one (see compositor_renderer below) doesn't necessarily\n"
    out = out + "! affect the other.\n"
    out = out + "! If the named compositor binary can't be found, HDM logs it and falls\n"
    out = out + "! back to launching greeter_path directly for that cycle rather than\n"
    out = out + "! refusing to show a login screen at all.\n"
    out = out + "-> compositor => cage\n"
    out = out + "\n"
    out = out + "! Forces the compositor's rendering backend via the WLR_RENDERER\n"
    out = out + "! environment variable. Leave commented out to let cage/wlroots\n"
    out = out + "! auto-detect (normally GLES2 over EGL/GBM). Uncomment and set to\n"
    out = out + "! \"pixman\" if cage crashes at startup right after the EGL/render lines in\n"
    out = out + "! its log with \"Assertion 'surface->initialized' failed\" (and a\n"
    out = out + "! \"Broken pipe\" message on the greeter's side right after) - that is\n"
    out = out + "! a cage/wlroots GLES2+EGL/GBM renderer crash on certain GPU driver\n"
    out = out + "! combinations (seen on some Intel i915 setups), not an HDM or greeter\n"
    out = out + "! bug, and switching cage to the software Pixman renderer sidesteps it.\n"
    out = out + "! See the README's Troubleshooting section.\n"
    out = out + "! -> compositor_renderer => pixman\n"
    out = out + "\n"
    out = out + "! Uncomment to run the greeter (and the compositor above) as a specific\n"
    out = out + "! unprivileged system user instead of root. Only do this once that user\n"
    out = out + "! has the device access cage needs (/dev/dri, /dev/input - typically the\n"
    out = out + "! video/render/input groups, plus an active seatd/systemd-logind seat\n"
    out = out + "! session) - otherwise cage will simply fail to open the display as that\n"
    out = out + "! user, the same way it fails without XDG_RUNTIME_DIR. See\n"
    out = out + "! daemon/src/session.h#::resolve_greeter_runtime_user.\n"
    out = out + "! -> greeter_user => _hdm\n"
    out = out + "\n"
    out = out + "[autologin]\n"
    out = out + "! Live-mode autologin (Blue Installer / live-boot media) - active by\n"
    out = out + "! default and independent of everything else in this section: if ANY\n"
    out = out + "! user's home directory contains the marker file named by live_marker\n"
    out = out + "! below, HDM logs that user straight in with no password prompt and no\n"
    out = out + "! further [autologin] configuration required at all - no user/session/\n"
    out = out + "! delay needs to be set, and the account doesn't need to fall inside\n"
    out = out + "! minimum_uid/maximum_uid above either (a live image's built-in user\n"
    out = out + "! commonly doesn't). See daemon/src/users.h#::find_live_user. Blue\n"
    out = out + "! Installer deletes the marker file once installation completes, so the\n"
    out = out + "! next boot goes back to a normal password prompt.\n"
    out = out + "-> live_detect => true\n"
    out = out + "-> live_marker => \".config/Blue-Environment/.live\"\n"
    out = out + "\n"
    out = out + "! Uncomment and fill in to force autologin unconditionally into a specific\n"
    out = out + "! user/session instead (skips the greeter, live-mode detection, and any\n"
    out = out + "! password prompt entirely):\n"
    out = out + "! -> user    => username\n"
    out = out + "! -> session => blue-environment\n"
    out = out + "! -> delay   => 0\n"
    out = out + "\n"
    out = out + "[default]\n"
    out = out + "! ID of the session HDM treats as the default: matched against the \"id\"\n"
    out = out + "! of a .desktop file found by scanning [general] -> sessions_dir above\n"
    out = out + "! (see daemon/src/session.h#::list_sessions), or the built-in\n"
    out = out + "! \"blue-environment\" fallback session, which always exists even with no\n"
    out = out + "! matching .desktop file. Used to pre-select a session in the greeter's\n"
    out = out + "! session picker, and as the session live-mode autologin (and any\n"
    out = out + "! [autologin] entry that omits `session`) launches into. Falls back to\n"
    out = out + "! \"blue-environment\" if unset or if it doesn't match any session actually\n"
    out = out + "! found - see daemon/src/session.h#::get_default_session.\n"
    out = out + "-> session => blue-environment\n"
    out = out + "\n"
    out = out + "[power]\n"
    out = out + "! Shell commands HDM runs (via `sh -c`) for each power-menu action -\n"
    out = out + "! see daemon/src/ipc.h#::GreeterRequest::PowerAction.\n"
    out = out + "-> shutdown  => \"shutdown -h now\"\n"
    out = out + "-> reboot    => reboot\n"
    out = out + "-> suspend   => \"systemctl suspend\"\n"
    out = out + "-> hibernate => \"systemctl hibernate\"\n"
    return out
end
