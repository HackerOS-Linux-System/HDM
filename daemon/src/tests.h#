#[test]
fn test_passwd_line_parsing() is
    let e: users::PwEntry = users::parse_passwd_line("alice:x:1000:1001:Alice A,,,:/home/alice:/bin/bash")
    assert_eq(e.name, "alice")
    assert_eq(e.uid, 1000)
    assert_eq(e.gid, 1001)
