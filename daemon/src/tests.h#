;; ── limiter ─────────────────────────────────────────────────────────────────

fn fail_n(rl0: pam_auth::RateLimiter, user: string, n: int, now: int) -> pam_auth::FailureResult is
    let mut rl: pam_auth::RateLimiter = rl0
    let mut last: pam_auth::FailureResult = pam_auth::record_failure(rl, user, now)
    let mut i: int = 1
    while i < n is
        rl = last.limiter
        last = pam_auth::record_failure(rl, user, now)
        i += 1
    end
    return last
end

#[test]
fn test_allows_first_attempt() is
    let rl: pam_auth::RateLimiter = pam_auth::new_limiter()
    assert_true(!pam_auth::check(rl, "alice", 0).locked)
end

#[test]
fn test_locks_out_after_threshold() is
    let r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 5, 1000)
    assert_eq(r.locked_for, 30)
    assert_eq(r.attempts_left, 0)
    let c: pam_auth::LimitCheck = pam_auth::check(r.limiter, "alice", 1000)
    assert_true(c.locked)
    assert_eq(c.seconds_left, 31)
end

#[test]
fn test_attempts_left_counts_down() is
    let r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 2, 0)
    assert_eq(r.attempts_left, 3)
    assert_eq(r.locked_for, 0)
end

#[test]
fn test_lockout_is_per_username() is
    let r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 5, 0)
    assert_true(pam_auth::check(r.limiter, "alice", 0).locked)
    assert_true(!pam_auth::check(r.limiter, "bob", 0).locked)
end

#[test]
fn test_success_clears_fail_count() is
    let r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 4, 0)
    let cleared: pam_auth::RateLimiter = pam_auth::record_success(r.limiter, "alice")
    let again: pam_auth::FailureResult = pam_auth::record_failure(cleared, "alice", 0)
    assert_eq(again.attempts_left, 4)
end

#[test]
fn test_lockout_expires() is
    let r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 5, 0)
    assert_true(pam_auth::check(r.limiter, "alice", 29000).locked)
    assert_true(!pam_auth::check(r.limiter, "alice", 30001).locked)
end

#[test]
fn test_backoff_grows_and_caps() is
    ;; 5. porażka -> 30 s; po wygaśnięciu kolejne okna: 60, 120, 240, 300 (limit)
    let mut r: pam_auth::FailureResult = fail_n(pam_auth::new_limiter(), "alice", 5, 0)
    assert_eq(r.locked_for, 30)
    let mut now: int = 0
    let expect: [int] = [60, 120, 240, 300, 300]
    let mut k: int = 0
    while k < array_len(expect) is
        now = now + 400000
        r = pam_auth::record_failure(r.limiter, "alice", now)
        assert_eq(r.locked_for, expect[k])
        k += 1
    end
end

;; ── /etc/shadow ─────────────────────────────────────────────────────────────

#[test]
fn test_account_status_detection() is
    let shadow: string = "root:$6$abc$def:19000:0:99999:7:::\nlocked:!$6$abc$def:19000::::::\nnopass:*:19000::::::\nempty::19000::::::\nalice:$y$j9T$salt$hash:19000::::::\n"
    assert_eq(pam_auth::parse_account_status(shadow, "alice"), pam_auth::status_active())
    assert_eq(pam_auth::parse_account_status(shadow, "locked"), pam_auth::status_locked())
    assert_eq(pam_auth::parse_account_status(shadow, "nopass"), pam_auth::status_no_password())
    assert_eq(pam_auth::parse_account_status(shadow, "empty"), pam_auth::status_no_password())
    assert_eq(pam_auth::parse_account_status(shadow, "ghost"), pam_auth::status_not_found())
end

#[test]
fn test_account_status_matches_whole_username_field() is
    ;; "ali" nie może trafić w wiersz "alice", a "root:$6" nie może „zgadnąć” wpisu roota
    let shadow: string = "alice:$6$x$y:1::::::\nroot:$6$x$y:1::::::\n"
    assert_eq(pam_auth::parse_account_status(shadow, "ali"), pam_auth::status_not_found())
    assert_eq(pam_auth::parse_account_status(shadow, "root:$6$x$y"), pam_auth::status_not_found())
end

#[test]
fn test_username_validation() is
    assert_true(pam_auth::valid_username("alice"))
