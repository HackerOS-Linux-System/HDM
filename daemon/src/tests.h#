#[test]
fn test_hk_basic_sections_and_types() is
    let doc: hk::HkDoc = hk::load("! komentarz\n[general]\n-> vt => 3\n-> name => \"a b\"\n-> flag => true\n-> list => [\"x\", y, 3]\n")
    assert_eq(doc.error, "")
    assert_eq(hk::get_int(doc, "general.vt", 0), 3)
    assert_eq(hk::get(doc, "general.name", ""), "a b")
    assert_true(hk::get_bool(doc, "general.flag", false))
    let l: [string] = hk::get_array(doc, "general.list")
    assert_eq(array_len(l), 3)
    assert_eq(l[0], "x")
    assert_eq(l[1], "y")
    assert_eq(l[2], "3")
end

#[test]
fn test_hk_nested_keys() is
    let doc: hk::HkDoc = hk::load("[s]\n-> a\n--> b => 1\n--> c\n---> d => 2\n")
    assert_eq(hk::get_int(doc, "s.a.b", 0), 1)
    assert_eq(hk::get_int(doc, "s.a.c.d", 0), 2)
end

#[test]
fn test_hk_interpolation_is_resolved() is
    let doc: hk::HkDoc = hk::load("[project]\n-> base => /srv\n[paths]\n-> bg => \"$" + jsonw::lb() + "project.base" + jsonw::rb() + "/wall.png\"\n")
    assert_eq(doc.error, "")
    assert_eq(hk::get(doc, "paths.bg", ""), "/srv/wall.png")
end

#[test]
fn test_hk_unresolved_or_cyclic_interpolation_is_an_error() is
    let a: hk::HkDoc = hk::load("[x]\n-> a => $" + jsonw::lb() + "x.missing" + jsonw::rb() + "\n")
    assert_true(a.error != "")
    let b: hk::HkDoc = hk::load("[x]\n-> a => $" + jsonw::lb() + "x.b" + jsonw::rb() + "\n-> b => $" + jsonw::lb() + "x.a" + jsonw::rb() + "\n")
    assert_true(b.error != "")
end

#[test]
fn test_hk_malformed_is_reported_as_an_error_not_a_crash() is
    assert_true(hk::load("[broken\n").error != "")
    assert_true(hk::load("this is not hk\n").error != "")
    assert_true(hk::load("-x y\n").error != "")
end

#[test]
fn test_hk_later_value_wins_and_quoted_escapes() is
    let doc: hk::HkDoc = hk::load("[g]\n-> a => 1\n-> a => 2\n-> q => \"he said \\\"hi\\\"\"\n")
    assert_eq(hk::get_int(doc, "g.a", 0), 2)
    assert_eq(hk::get(doc, "g.q", ""), "he said \"hi\"")
end

