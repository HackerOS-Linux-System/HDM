#[test]
fn test_lockout_response_shapes() is
    let plain: string = ipc::lockout_aware_failure("Incorrect password", 3, 0)
    assert_eq(jsonw::get_str(plain, "type"), "auth_failure")
    assert_eq(jsonw::get_str(plain, "reason"), "Incorrect password")
    assert_eq(jsonw::get_int(plain, "attempts_left", -1), 3)
    let locked: string = ipc::lockout_aware_failure("Incorrect password", 0, 60)
    assert_true(string_contains(jsonw::get_str(locked, "reason"), "locked for 60s"))
    assert_eq(jsonw::get_int(locked, "attempts_left", -1), 0)
end

#[test]
fn test_json_roundtrip_with_hostile_strings() is
    let nasty: string = "p\"a\\ss\nw" + jsonw::lb() + "o" + jsonw::rb() + "rd"
    let j: string = jsonw::obj([jsonw::f_str("password", nasty), jsonw::f_int("n", 7), jsonw::f_bool("ok", true)])
    assert_eq(jsonw::get_str(j, "password"), nasty)
    assert_eq(jsonw::get_int(j, "n", 0), 7)
    assert_true(jsonw::get_bool(j, "ok", false))
end

#[test]
fn test_json_int_array() is
    let a: [int] = jsonw::get_int_array(jsonw::obj([jsonw::f_raw("pattern", "[0,1,2,4]")]), "pattern")
    assert_eq(array_len(a), 4)
    assert_eq(a[3], 4)
    assert_eq(array_len(jsonw::get_int_array(jsonw::obj([jsonw::f_int("x", 1)]), "pattern")), 0)
end
