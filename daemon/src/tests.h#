;; ── sesje ───────────────────────────────────────────────────────────────────

fn mk(id: string) -> session::SessionInfo is
    return session::SessionInfo { id: id, name: id, exec: "/usr/bin/" + id, session_type: "wayland", desktop_names: [], icon: "", comment: "" }
end

#[test]
fn test_default_session_resolution() is
    let list: [session::SessionInfo] = [mk("blue-environment"), mk("gnome")]
    assert_eq(session::resolve_default_session("gnome", list), "gnome")
    assert_eq(session::resolve_default_session("plasma", list), "blue-environment")
    assert_eq(session::resolve_default_session("", list), "blue-environment")
end

#[test]
fn test_desktop_file_parsing() is
    let ok: session::SessionInfo = session::parse_desktop_content("[Desktop Entry]\nName=Gnome\nExec=gnome-session\nDesktopNames=GNOME;Unity;\nIcon=gnome\n[Other]\nName=ignored\n", "gnome", "wayland")
    assert_eq(ok.id, "gnome")
    assert_eq(ok.name, "Gnome")
    assert_eq(ok.exec, "gnome-session")
    assert_eq(array_len(ok.desktop_names), 2)
    assert_eq(ok.icon, "gnome")
    assert_eq(session::parse_desktop_content("[Desktop Entry]\nName=X\nExec=x\nNoDisplay=true\n", "x", "x11").id, "")
    assert_eq(session::parse_desktop_content("[Desktop Entry]\nName=X\n", "x", "x11").id, "")
end

#[test]
fn test_blue_environment_sorts_first() is
    let sorted: [session::SessionInfo] = session::sort_sessions([mk("zeta"), mk("alpha"), mk("blue-environment")])
    assert_eq(sorted[0].id, "blue-environment")
    assert_eq(sorted[1].id, "alpha")
    assert_eq(sorted[2].id, "zeta")
end

#[test]
fn test_session_json_omits_empty_optionals() is
    let j: string = session::session_json(mk("gnome"))
    assert_true(!string_contains(j, "icon"))
    assert_true(!string_contains(j, "comment"))
    assert_true(string_contains(j, "\"id\":\"gnome\""))
end

