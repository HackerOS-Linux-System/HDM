pub fn from_hk(doc: hk::HkDoc) -> HdmConfig is
    let d: HdmConfig = defaults()
    let dirs: [string] = if hk::has(doc, "general.sessions_dir") then hk::get_array(doc, "general.sessions_dir") else d.sessions_dir
    return HdmConfig {
        greeter_path: hk::get(doc, "general.greeter_path", d.greeter_path),
        vt: hk::get_int(doc, "general.vt", d.vt),
        compositor: hk::get(doc, "general.compositor", d.compositor),
        compositor_renderer: hk::get(doc, "general.compositor_renderer", d.compositor_renderer),
        greeter_user: hk::get(doc, "general.greeter_user", d.greeter_user),
        greeter_memory_limit: hk::get_int(doc, "general.greeter_memory_limit", d.greeter_memory_limit),
        autologin_user: hk::get(doc, "autologin.user", ""),
        autologin_session: hk::get(doc, "autologin.session", ""),
        autologin_delay: hk::get_int(doc, "autologin.delay", d.autologin_delay),
        live_autologin: hk::get_bool(doc, "autologin.live_detect", d.live_autologin),
        live_marker_path: hk::get(doc, "autologin.live_marker", d.live_marker_path),
        session_timeout: hk::get_int(doc, "general.session_timeout", d.session_timeout),
        theme: hk::get(doc, "general.theme", d.theme),
        background: hk::get(doc, "general.background", d.background),
        clock_format: hk::get(doc, "general.clock_format", d.clock_format),
        show_user_list: hk::get_bool(doc, "general.show_user_list", d.show_user_list),
        allow_root: hk::get_bool(doc, "general.allow_root", d.allow_root),
        allow_guest: hk::get_bool(doc, "general.allow_guest", d.allow_guest),
        minimum_uid: hk::get_int(doc, "general.minimum_uid", d.minimum_uid),
        maximum_uid: hk::get_int(doc, "general.maximum_uid", d.maximum_uid),
        sessions_dir: dirs,
        default_session: hk::get(doc, "default.session", d.default_session),
        power_shutdown: hk::get(doc, "power.shutdown", d.power_shutdown),
        power_reboot: hk::get(doc, "power.reboot", d.power_reboot),
        power_suspend: hk::get(doc, "power.suspend", d.power_suspend),
        power_hibernate: hk::get(doc, "power.hibernate", d.power_hibernate)
    }
end

;; Parsuje tekst .hk (bez dostępu do dysku).
pub fn load_config_str(content: string) -> LoadResult is
    let doc: hk::HkDoc = hk::load(content)
    if doc.error != "" is
        return LoadResult { cfg: defaults(), error: ".hk parse error: " + doc.error }
    end
    return LoadResult { cfg: from_hk(doc), error: "" }
end

pub fn load_config(path: string) -> LoadResult is
    if !fs::exists(path) is
        return LoadResult { cfg: defaults(), error: "Cannot load " + path + ": file not found" }
    end
    let r: LoadResult = load_config_str(fs::read(path))
    if r.error != "" is
        return LoadResult { cfg: r.cfg, error: r.error + " (in " + path + ")" }
    end
    return r
end

pub fn default_config_content() -> string is
    return default_config::text()
end

;; Zapisuje domyślny /etc/hdm/hdm.hk, jeśli plik nie istnieje.
pub fn ensure_default_config() is
    let config_path: string = "/etc/hdm/hdm.hk"
    if fs::exists(config_path) is return end
    fs::mkdir("/etc/hdm")
    ;; fs::write nie zwraca wartości w backendzie H# (void) — sprawdzamy efekt przez fs::exists
    fs::write(config_path, default_config_content())
    if !fs::exists(config_path) is
        logging::warn("Could not write default config to " + config_path)
    end
end
