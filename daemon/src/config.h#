use "bit -> hdm-common" from "common"
use "std -> fs" from "fs"
mod default_config
mod logging

pub struct HdmConfig is
    pub greeter_path:        string
    pub vt:                  int
    ;; Kompozytor Wayland, w którym uruchamiany jest greeter: "cage" (domyślnie), "labwc", "none" albo
    ;; inny binarek zgodny z cage (-s -- <cmd>). Patrz main.h#::compositor_argv.
    pub compositor:          string
    ;; WLR_RENDERER dla kompozytora (np. "pixman"); "" = auto.
    pub compositor_renderer: string
    ;; Użytkownik systemowy dla greetera; "" = root.
    pub greeter_user:        string
    ;; Limit pamięci (MiB, suma RSS kompozytora + greetera); po przekroczeniu daemon restartuje greetera. 0 = bez limitu.
    pub greeter_memory_limit: int
    pub autologin_user:      string
    pub autologin_session:   string
    pub autologin_delay:     int
    pub live_autologin:      bool
    pub live_marker_path:    string
    pub session_timeout:     int
    pub theme:               string
    pub background:          string
    pub clock_format:        string
    pub show_user_list:      bool
    pub allow_root:          bool
    pub allow_guest:         bool
    pub minimum_uid:         int
    pub maximum_uid:         int
    pub sessions_dir:        [string]
    pub default_session:     string
    pub power_shutdown:      string
    pub power_reboot:        string
    pub power_suspend:       string
    pub power_hibernate:     string
end

pub struct LoadResult is
    pub cfg:   HdmConfig
    pub error: string
end

pub fn default_sessions_dir() -> [string] is
    return ["/usr/share/wayland-sessions", "/usr/share/xsessions", "/usr/local/share/wayland-sessions"]
end

