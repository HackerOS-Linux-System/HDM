! /etc/hdm/hdm.hk — HDM (HackerOS Display Manager) Configuration
!
! Format: .hk — HackerOS's own configuration format (a TOML alternative
! with explicit "-> key => value" nesting and built-in ${...}
! interpolation). Full syntax reference:
!   https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html
!
! This file is installed verbatim by `build.hl install` / the .deb / the
! .rpm the first time HDM is set up (an existing /etc/hdm/hdm.hk is never
! overwritten — see install_config in build.hl). It is also what the
! daemon itself writes to a fresh /etc/hdm/hdm.hk if none exists yet, via
! config::ensure_default_config() in daemon/src/config.rs.
!
! IMPORTANT for maintainers: daemon/src/config.rs has a test
! (packaged_config_file_matches_default_config_content) that asserts this
! file parses to exactly the same HdmConfig as
! config::default_config_content() — [general], [autologin], [default] and
! [power] alike. If you change a value in one, change it in the other —
! `cd daemon && cargo test` will fail loudly if they drift apart.

[general]
! Path to the greeter binary the daemon spawns on VT switch.
-> greeter_path   => "/usr/bin/hdm-greeter"

! Virtual terminal HDM switches to before launching the greeter.
-> vt             => 1

! Greeter theme name (passed through to the UI, see ui/src/app.css).
-> theme          => graphite

! Path to the wallpaper image shown behind the login screen. Falls back
! to a handful of hardcoded paths (see get_wallpaper() in
! greeter/src/main.rs) if this is unset, empty, or the file is missing.
-> background     => "/usr/share/wallpapers/HackerOS-Wallpapers/Wallpaper23.png"

! Show the list of local users (UID between minimum_uid and maximum_uid)
! on the login screen, rather than only a plain username field.
-> show_user_list => true

! Whether "root" is an allowed login username. Kept off by default —
! logging in graphically as root is almost never what you want.
-> allow_root     => false

! Whether the greeter's "Guest" button is shown at all. See
! daemon/src/users.rs::ensure_guest_account for what a guest session is.
-> allow_guest    => false

! Only users with minimum_uid <= UID <= maximum_uid show up in the login
! screen's user list. Live-mode autologin (see [autologin] -> live_detect
! below) is NOT limited by this range on purpose — see
! daemon/src/users.rs::find_live_user.
-> minimum_uid    => 1000
-> maximum_uid    => 65533

! strftime-style format string for the greeter's on-screen clock.
-> clock_format   => "%H:%M"

! Directories scanned for Wayland/X11 session .desktop files (see
! daemon/src/session.rs::list_sessions). Later entries are for
! locally-installed sessions that override the system-wide ones.
-> sessions_dir   => ["/usr/share/wayland-sessions", "/usr/share/xsessions", "/usr/local/share/wayland-sessions"]

! Wayland compositor HDM wraps the greeter binary in before launching it
! (see spawn_greeter_command() in daemon/src/main.rs). The greeter is a
! windowed Tauri/WebKit app, not a compositor itself, so it needs one to
! actually get a display to render into pre-login. "cage" (a single-app
! Wayland kiosk compositor, see https://github.com/cage-kiosk/cage) is
! used by default; set to "none" to launch greeter_path directly instead.
! If the named compositor binary can't be found, HDM logs it and falls
! back to launching greeter_path directly for that cycle rather than
! refusing to show a login screen at all.
-> compositor => cage

! Forces the compositor's rendering backend via the WLR_RENDERER
! environment variable. Leave commented out to let cage/wlroots
! auto-detect (normally GLES2 over EGL/GBM). Uncomment and set to
! "pixman" if cage crashes at startup right after the EGL/render lines in
! its log with "Assertion 'surface->initialized' failed" (and a
! "Broken pipe" GDK message on the greeter's side right after) — that is
! a cage/wlroots GLES2+EGL/GBM renderer crash on certain GPU driver
! combinations (seen on some Intel i915 setups), not an HDM or greeter
! bug, and switching cage to the software Pixman renderer sidesteps it.
! See the README's Troubleshooting section.
! -> compositor_renderer => pixman

! Uncomment to run the greeter (and the compositor above) as a specific
! unprivileged system user instead of root. Only do this once that user
! has the device access cage needs (/dev/dri, /dev/input — typically the
! video/render/input groups, plus an active seatd/systemd-logind seat
! session) — otherwise cage will simply fail to open the display as that
! user, the same way it fails without XDG_RUNTIME_DIR. See
! daemon/src/session.rs::resolve_greeter_runtime_user.
! -> greeter_user => _hdm

[autologin]
! Live-mode autologin (Blue Installer / live-boot media) — active by
! default and independent of everything else in this section: if ANY
! user's home directory contains the marker file named by live_marker
! below, HDM logs that user straight in with no password prompt and no
! further [autologin] configuration required at all — no user/session/
! delay needs to be set, and the account doesn't need to fall inside
! minimum_uid/maximum_uid above either (a live image's built-in user
! commonly doesn't). See daemon/src/users.rs::find_live_user. Blue
! Installer deletes the marker file once installation completes, so the
! next boot goes back to a normal password prompt.
-> live_detect => true
-> live_marker => ".config/Blue-Environment/.live"

! Uncomment and fill in to force autologin unconditionally into a specific
! user/session instead (skips the greeter, live-mode detection, and any
! password prompt entirely):
! -> user    => username
! -> session => blue-environment
! -> delay   => 0

[default]
! ID of the session HDM treats as the default: matched against the "id"
! of a .desktop file found by scanning [general] -> sessions_dir above
! (see daemon/src/session.rs::list_sessions), or the built-in
! "blue-environment" fallback session, which always exists even with no
! matching .desktop file. Used to pre-select a session in the greeter's
! session picker, and as the session live-mode autologin (and any
! [autologin] entry that omits `session`) launches into. Falls back to
! "blue-environment" if unset or if it doesn't match any session actually
! found — see daemon/src/session.rs::get_default_session.
-> session => blue-environment

[power]
! Shell commands HDM runs (via `sh -c`) for each power-menu action —
! see daemon/src/ipc.rs::GreeterRequest::PowerAction.
-> shutdown  => "shutdown -h now"
-> reboot    => reboot
-> suspend   => "systemctl suspend"
-> hibernate => "systemctl hibernate"
