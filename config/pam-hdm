#%PAM-1.0
#
# /etc/pam.d/hdm — installed as config/pam-hdm, see install_pam in build.hl.
#
# NOTE: HDM's own password check (daemon/src/pam_auth.rs::authenticate)
# does NOT call into libpam — it reads /etc/shadow directly and verifies
# the crypt(3) hash itself (see the comments at the top of pam_auth.rs for
# why: portability across glibc hash formats without a libpam FFI binding).
# This file exists for everything else in the login path that *does* go
# through PAM by service name "hdm": most importantly `pam_systemd`, which
# registers the graphical session with systemd-logind (XDG_RUNTIME_DIR,
# loginctl session tracking, `systemctl --user`) once
# daemon/src/session.rs::launch_session hands off to the session process —
# without this file (or with it misconfigured), pam_systemd has nothing to
# register against and `systemctl --user` / XDG_RUNTIME_DIR permissions in
# the launched session can end up wrong.

auth       required     pam_unix.so nullok
auth       optional     pam_permit.so

account    required     pam_unix.so
account    optional     pam_permit.so

password   required     pam_unix.so

session    required     pam_unix.so
session    optional     pam_permit.so
# Failure here must not block login (leading '-'): register the session
# with systemd-logind when available, but don't hard-fail on systems
# without systemd.
-session   optional     pam_systemd.so
session    optional     pam_env.so readenv=1
session    optional     pam_keyinit.so force revoke
session    optional     pam_limits.so
