{
  "name": "hdm-greeter-frontend",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Frontend greetera HDM (Solid.js + TypeScript) dla Silver",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "build:fast": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/oxanium": "5.3.0",
    "lucide-solid": "0.460.0",
    "solid-js": "^1.9.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^9.15.0",
    "@hackeros/silver-types": "^0.5.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "babel-preset-solid": "^1.9.0",
    "esbuild": "^0.24.0",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.3.1",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.5"
  }
}
